{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: Launch Server",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/src/company/app/backend/server/main.go",
      "cwd": "${workspaceFolder}",
      "env": {
        "GOFLAGS": "-mod=readonly"
      },
      "showLog": true,
      "logFile": "${workspaceFolder}/.vscode/go-backend.log",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Frontend: Dev Server",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "--host", "0.0.0.0"],
      "cwd": "${workspaceFolder}/src/company/app/frontend",
      "console": "integratedTerminal",
      // "serverReadyAction": {
      //   "pattern": "Local:\\s+http://localhost:([0-9]+)",
      //   "uriFormat": "http://localhost:%s",
      //   "action": "openExternally"
      // }
    },
    {
      "name": "Frontend: Build",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "build"],
      "cwd": "${workspaceFolder}/src/company/app/frontend",
      "console": "integratedTerminal"
    },
    {
      "name": "Frontend: Debug Browser",
      "type": "firefox",
      "request": "launch",
      "url": "http://0.0.0.0:5173",
      "webRoot": "${workspaceFolder}/src/company/app/frontend",
      "reAttach": true,
      "serverReadyAction": {
        "pattern": "Local:\\s+http://0.0.0.0:([0-9]+)",
        "uriFormat": "http://0.0.0.0:%s",
        "action": "openExternally"
      },
      // "preLaunchTask": "npm: dev"
    }
  ],
  "compounds": [
    {
      "name": "Fullstack",
      "configurations": ["Backend: Launch Server", "Frontend: Build", "Frontend: Dev Server", "Frontend: Debug Browser"],
      "stopAll": true
    }
  ]
}