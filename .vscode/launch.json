{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Backend",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/src/company/app/backend/server/main.go",
      "cwd": "${workspaceFolder}",
      "env": {
        "GOFLAGS": "-mod=readonly"
      },
      "showLog": true,
      "logFile": "${workspaceFolder}/.vscode/go-backend.log",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Run Frontend",
      "type": "firefox",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/src/company/app/frontend",
      "reAttach": true,
      "preLaunchTask": "npm: dev"
    }
  ],
  "compounds": [
    {
      "name": "Fullstack",
      "configurations": ["Run Backend", "Run Frontend"]
    }
  ]
}