{
  "dockerComposeFile": "docker-compose.yml",
  "service": "devcontainer",
  "shutdownAction": "stopCompose",
  "customizations": {
    "vscode": {
      "settings": {
        "go.coverOnSave": true,
        "go.coverOnSingleTest": true,
        "go.coverageDecorator": {
            "type": "gutter",
            "coveredHighlightColor": "rgba(64,128,128,0.5)",
            "uncoveredHighlightColor": "rgba(128,64,64,0.25)",
            "coveredGutterStyle": "blockgreen",
            "uncoveredGutterStyle": "blockred"
        },
        "mssql.connections": [
          {
            "profileName": "wide-world-importers",
            "authenticationType": "SqlLogin",
            "connectTimeout": 15,
            "server": "localhost",
            "trustServerCertificate": true,
            "user": "cc520-admin",
            "password": "",
            "emptyPasswordInput": false,
            "savePassword": true,
            "database": "WideWorldImporters",
            "port": 1433
          },
          {
            "profileName": "CC520",
            "authenticationType": "SqlLogin",
            "connectTimeout": 15,
            "server": "localhost",
            "trustServerCertificate": true,
            "user": "cc520-admin",
            "password": "",
            "emptyPasswordInput": false,
            "savePassword": true,
            "database": "CC520",
            "port": 1433
          },
          {
            "profileName": "ms-sql-server-admin",
            "authenticationType": "SqlLogin",
            "connectTimeout": 15,
            "server": "localhost",
            "trustServerCertificate": true,
            "user": "SA",
            "password": "",
            "emptyPasswordInput": false,
            "savePassword": true,
            "database": "",
            "port": 1433
          }
        ],
        "terminal.integrated.fontSize": 14,
        "git.enableSmartCommit": true,
        "git.confirmSync": false,
        "git.autofetch": true,
        "editor.mouseWheelZoom": true,
        "editor.tabCompletion": "on",
        "files.autoSave": "afterDelay",
        "editor.stickyTabStops": true,
        "editor.minimap.enabled": false,
        "mssql.format.datatypeCasing": "uppercase",
        "mssql.format.keywordCasing": "uppercase",
        "mssql.format.alignColumnDefinitionsInColumns": true
        // Use ${containerWorkspaceFolder} so paths stay portable
        // Optional quality-of-life settings
      },
      "extensions": [
        "ms-vscode-remote.remote-wsl",
        "yzhang.markdown-all-in-one",
        "ms-mssql.mssql",
        "ms-toolsai.datawrangler",
        "bierner.markdown-mermaid",
        "firefox-devtools.vscode-firefox-debug"
      ]
    }
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  // Features to add to the dev container. More info: https://containers.dev/features.  
  "features": {
    "ghcr.io/danzilberdan/devcontainers/opencode:0": {},
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "10.0",
      // Installs .NET 10 SDK
      // "version": "latest"     // Or track latest GA
      "additionalVersions": "9.0"
      // Optional: side-by-side SDKs
    },
    "ghcr.io/devcontainers/features/node:2": {
      "version": "20"
    }
  },
  "mounts": [
    {
      "source": "${localWorkspaceFolder}/.opencode/auth.json",
      "target": "/mnt/opencode-auth.json",
      "type": "bind"
    }
  ],
  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  "forwardPorts": [
    1433,
    8080,
    5173
  ],
  "remoteEnv": {
    "SQL_SECRETS": "{\"credentials\":[{\"credentialId\":\"Microsoft.SqlTools|itemtype:Profile|server:localhost|db:CC520|user:cc520-admin\",\"password\":\"database3ssentials!\"},{\"credentialId\":\"Microsoft.SqlTools|itemtype:Mru|server:localhost|db:CC520|user:cc520-admin\",\"password\":\"database3ssentials!\"},{\"credentialId\":\"Microsoft.SqlTools|itemtype:Profile|server:localhost|db:WideWorldImporters|user:cc520-admin\",\"password\":\"database3ssentials!\"},{\"credentialId\":\"Microsoft.SqlTools|itemtype:Mru|server:localhost|db:WideWorldImporters|user:cc520-admin\",\"password\":\"database3ssentials!\"},{\"credentialId\":\"Microsoft.SqlTools|itemtype:Profile|server:localhost|user:SA\",\"password\":\"sup3rs3cur3P@ssword\"},{\"credentialId\":\"Microsoft.SqlTools|itemtype:Mru|server:localhost|db:master|user:SA\",\"password\":\"sup3rs3cur3P@ssword\"}]}"
  },
  "postCreateCommand": "mkdir -p ~/.sqlsecrets && echo \"$SQL_SECRETS\" > ~/.sqlsecrets/sqlsecrets.json"
}
